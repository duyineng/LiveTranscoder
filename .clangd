# clangd reads compile flags from compile_commands.json (generated by CMake/Ninja).
CompilationDatabase: out/build/x64-debug

CompileFlags:
  # compile_commands.json is produced by MSVC (cl.exe). Tell clangd to parse those flags.
  Add:
    - --driver-mode=cl
  Remove:
    - /utf-8
    - /external:*
    - -external:*
